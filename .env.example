# Supabase — get these from https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic — required for the smart voice assistant (Claude Haiku)
# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# RevenueCat Web Billing — subscription payments (optional: when unset,
# all Pro features stay unlocked for everyone)
# 1. Create a project at https://app.revenuecat.com with a Web Billing app
# 2. Create products ($rc_monthly $4, $rc_annual $24) and a "pro" entitlement
# 3. Public API key → VITE_REVENUECAT_PUBLIC_KEY
# 4. Webhook (Integrations → Webhooks): URL https://<domain>/api/revenuecat-webhook
#    with Authorization header "Bearer <REVENUECAT_WEBHOOK_AUTH>"
# 5. Apply supabase/migrations/003_add_subscription.sql to your database
VITE_REVENUECAT_PUBLIC_KEY=
REVENUECAT_WEBHOOK_AUTH=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar sync (optional: when unset, the feature is hidden entirely)
# 1. Google Cloud Console → new project → enable the "Google Calendar API"
# 2. OAuth consent screen: External, add scope
#    https://www.googleapis.com/auth/calendar.events (sensitive — needs
#    Google verification before going public; up to 100 test users meanwhile)
# 3. Credentials → OAuth client ID → Web application, authorized redirect URI:
#    https://<your-domain>/api/google/callback
# 4. Apply supabase/migrations/004_task_lists_and_calendar.sql
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string — signs the OAuth state parameter
GOOGLE_OAUTH_STATE_SECRET=
